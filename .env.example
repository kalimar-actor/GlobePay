# Database
DATABASE_URL=postgresql://globepay:globepay@postgres:5432/globepay

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_REFRESH_EXPIRATION=7d

# Port
PORT=3000
NODE_ENV=development

# Firebase Cloud Messaging
FCM_SERVER_KEY=your-fcm-server-key
FCM_PROJECT_ID=your-fcm-project-id

# Argon2
ARGON2_MEMORY=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# Settlement
SETTLEMENT_CRON_SCHEDULE=* * * * *
SETTLEMENT_BATCH_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Fraud Detection
FRAUD_VELOCITY_LIMIT_24H=10000
FRAUD_VELOCITY_LIMIT_1H=2000
FRAUD_MAX_FAILED_LOGINS=5

# KYC
KYC_LEVEL_1_DAILY_LIMIT=100
KYC_LEVEL_2_DAILY_LIMIT=1000
KYC_LEVEL_3_DAILY_LIMIT=10000

# Admin
ADMIN_PANEL_URL=http://localhost:3001
ADMIN_API_KEY=admin-api-key-change-in-production
